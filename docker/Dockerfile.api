FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY candidate_package/mock_api_server.py candidate_package/server_data.bin ./

EXPOSE 8080
CMD ["sh", "-c", "python /app/mock_api_server.py --port 8008 & exec socat TCP-LISTEN:8080,fork,reuseaddr TCP:127.0.0.1:8008"]